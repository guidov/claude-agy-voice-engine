#!/usr/bin/env bash
# ==============================================================================
# voice-engine: Master Control & Client Switch for Local Voice Engine
# ==============================================================================
# Provides independent, granular control for:
#   - Global Engine & Services: voice-engine [on|off|toggle|status|summary]
#   - Antigravity (AGY):        voice-engine agy [on|off|toggle|status|summary]
#   - Claude Code (Claude):     voice-engine claude [on|off|toggle|status|summary]
# ==============================================================================

set -uo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
USER_BIN="$HOME/.local/bin"
VOICEMODE_DIR="$HOME/.voicemode"
VOICEMODE_BIN="$VOICEMODE_DIR/bin"
ENGINE_DISABLED="$VOICEMODE_DIR/engine-disabled"
SUMMARY_DISABLED="$VOICEMODE_DIR/summary-disabled"
SUMMARY_AGY_DISABLED="$VOICEMODE_DIR/summary-agy-disabled"
SUMMARY_CLAUDE_DISABLED="$VOICEMODE_DIR/summary-claude-disabled"
SOUNDFONTS_DISABLED="$VOICEMODE_DIR/soundfonts-disabled"
GEMINI_CONFIG_DIR="$HOME/.gemini/config"
CLAUDE_CONFIG_DIR="$HOME/.claude"

SERVICES=("whisper-server.service" "claude-voice-bridge.service" "dictate.service")

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

log() { echo -e "${BLUE}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*"; }

is_service_active() {
    systemctl --user is-active --quiet "$1" 2>/dev/null
}

is_port_listening() {
    ss -tln 2>/dev/null | grep -E ":$1($|[[:space:]])" >/dev/null 2>&1 || nc -z 127.0.0.1 "$1" 2>/dev/null
}

stop_playback() {
    if [ -f "$USER_BIN/voicemode-stop" ]; then
        "$USER_BIN/voicemode-stop" >/dev/null 2>&1 || true
    fi
    pkill -f "pw-play.*voicemode" >/dev/null 2>&1 || true
}

speak_test_audio() {
    local text="${1:-Testing local voice engine audio playback.}"
    local outfile="/tmp/voice_engine_test.wav"
    ensure_services_running
    if is_service_active "claude-voice-bridge.service" && is_port_listening "8880"; then
        log "Synthesizing test audio via Kokoro TTS..."
        curl -s -X POST http://127.0.0.1:8880/v1/audio/speech \
            -H "Content-Type: application/json" \
            -d "{\"model\":\"kokoro\",\"input\":\"$text\",\"voice\":\"af_sky\",\"response_format\":\"wav\"}" \
            --output "$outfile" 2>/dev/null && pw-play "$outfile" 2>/dev/null || true
        success "Audio playback completed."
    else
        warn "Voice bridge (:8880) is not ready yet."
    fi
}

ensure_services_running() {
    local needed=0
    for svc in "${SERVICES[@]}"; do
        if ! is_service_active "$svc"; then
            needed=1
            break
        fi
    done
    if [ "$needed" -eq 1 ]; then
        log "Starting background voice services..."
        rm -f "$ENGINE_DISABLED"
        systemctl --user daemon-reload
        for svc in "${SERVICES[@]}"; do
            systemctl --user start "$svc" 2>/dev/null || true
        done
        sleep 0.5
    fi
}

# ==============================================================================
# Helper Inspection Functions
# ==============================================================================

is_agy_mcp_installed() {
    [ -f "$GEMINI_CONFIG_DIR/mcp_config.json" ] && grep -q '"voicemode"' "$GEMINI_CONFIG_DIR/mcp_config.json" 2>/dev/null
}

is_agy_mcp_enabled() {
    if ! is_agy_mcp_installed; then
        return 1
    fi
    python3 -c "
import json
try:
    d = json.load(open('$GEMINI_CONFIG_DIR/mcp_config.json'))
    v = d.get('mcpServers', {}).get('voicemode', {})
    exit(1 if v.get('disabled') is True else 0)
except Exception:
    exit(1)
" 2>/dev/null
}

is_agy_summary_enabled() {
    if [ -f "$SUMMARY_AGY_DISABLED" ] || [ -f "$ENGINE_DISABLED" ]; then
        return 1
    fi
    [ -f "$GEMINI_CONFIG_DIR/hooks.json" ] && grep -q "voicemode-summary-speaker" "$GEMINI_CONFIG_DIR/hooks.json" 2>/dev/null
}

is_claude_commands_installed() {
    [ -f "$CLAUDE_CONFIG_DIR/commands/talk.md" ] || [ -f "$CLAUDE_CONFIG_DIR/commands/localvoice.md" ]
}

is_claude_summary_enabled() {
    if [ -f "$SUMMARY_CLAUDE_DISABLED" ] || [ -f "$ENGINE_DISABLED" ]; then
        return 1
    fi
    if [ -f "$CLAUDE_CONFIG_DIR/settings.json" ]; then
        python3 -c "
import json
try:
    s = json.load(open('$CLAUDE_CONFIG_DIR/settings.json'))
    exit(0 if 'Stop' in s.get('hooks', {}) else 1)
except Exception:
    exit(1)
" 2>/dev/null
    else
        return 1
    fi
}

# ==============================================================================
# Dashboard Status
# ==============================================================================

engine_status() {
    echo -e "${BOLD}${CYAN}==========================================================${NC}"
    echo -e "${BOLD}${CYAN}    Local Voice Engine Status & Control Dashboard         ${NC}"
    echo -e "${BOLD}${CYAN}==========================================================${NC}"

    # Global master switch
    if [ -f "$ENGINE_DISABLED" ]; then
        echo -e "Global Engine Power  : ${RED}${BOLD}OFF (DISABLED)${NC}"
    else
        echo -e "Global Engine Power  : ${GREEN}${BOLD}ON (ENABLED)${NC}"
    fi

    # Global summaries
    if [ -f "$SUMMARY_DISABLED" ]; then
        echo -e "Global Turn Summaries: ${YELLOW}MUTED (Globally silent)${NC}"
    else
        echo -e "Global Turn Summaries: ${GREEN}ENABLED${NC}"
    fi

    echo ""
    echo -e "${BOLD}Background Services (Intel Arc B580 GPU & CPU):${NC}"

    # whisper-server
    if is_service_active "whisper-server.service"; then
        if is_port_listening "8910"; then
            echo -e "  - whisper-server   : ${GREEN}Running (:8910 - Intel Arc Vulkan)${NC}"
        else
            echo -e "  - whisper-server   : ${YELLOW}Starting / Initializing compute buffers...${NC}"
        fi
    else
        echo -e "  - whisper-server   : ${RED}Stopped${NC}"
    fi

    # claude-voice-bridge
    if is_service_active "claude-voice-bridge.service"; then
        local stt_ok="no"
        local tts_ok="no"
        is_port_listening "2022" && stt_ok="yes"
        is_port_listening "8880" && tts_ok="yes"
        if [ "$stt_ok" = "yes" ] && [ "$tts_ok" = "yes" ]; then
            echo -e "  - voice-bridge     : ${GREEN}Running (STT :2022, TTS :8880)${NC}"
        else
            echo -e "  - voice-bridge     : ${YELLOW}Starting (STT: $stt_ok, TTS: $tts_ok)...${NC}"
        fi
    else
        echo -e "  - voice-bridge     : ${RED}Stopped${NC}"
    fi

    # dictate.service
    if is_service_active "dictate.service"; then
        echo -e "  - push-to-talk     : ${GREEN}Running (Right-Ctrl dictate daemon)${NC}"
    else
        echo -e "  - push-to-talk     : ${RED}Stopped${NC}"
    fi

    echo ""
    echo -e "${BOLD}Client Integrations:${NC}"

    # Antigravity section
    if is_agy_mcp_enabled; then
        echo -e "  ${BOLD}[Antigravity (AGY)]${NC}"
        echo -e "    - Voice Engine   : ${GREEN}ON${NC} (MCP: connected, skills: /talk, /code)"
    elif is_agy_mcp_installed; then
        echo -e "  ${BOLD}[Antigravity (AGY)]${NC}"
        echo -e "    - Voice Engine   : ${YELLOW}DISABLED${NC} (MCP disabled in mcp_config.json)"
    else
        echo -e "  ${BOLD}[Antigravity (AGY)]${NC}"
        echo -e "    - Voice Engine   : ${RED}NOT INSTALLED${NC}"
    fi

    if is_agy_summary_enabled; then
        echo -e "    - Turn Summaries : ${GREEN}ON (Spoken via Kokoro TTS)${NC}"
    else
        echo -e "    - Turn Summaries : ${YELLOW}OFF (Silent completion mode)${NC}"
    fi

    # Claude Code section
    echo ""
    echo -e "  ${BOLD}[Claude Code]${NC}"
    if is_claude_commands_installed; then
        echo -e "    - Local Commands : ${GREEN}ON${NC} (/talk, /localvoice ready)"
    else
        echo -e "    - Local Commands : ${YELLOW}OFF / REMOVED${NC}"
    fi
    echo -e "    - Native /voice  : ${GREEN}CLEAN (0% interference)${NC}"

    if is_claude_summary_enabled; then
        echo -e "    - Turn Summaries : ${GREEN}ON (Spoken via Kokoro TTS)${NC}"
    else
        echo -e "    - Turn Summaries : ${YELLOW}OFF (Silent completion mode)${NC}"
    fi

    echo -e "${BOLD}${CYAN}==========================================================${NC}"
}

# ==============================================================================
# Global Engine Control
# ==============================================================================

engine_on() {
    log "Turning Local Voice Engine ON..."
    mkdir -p "$VOICEMODE_DIR"
    rm -f "$ENGINE_DISABLED"

    if [[ "${1:-}" == "--summary" ]] || [[ "${1:-}" == "--with-summary" ]]; then
        rm -f "$SUMMARY_DISABLED"
        log "Global spoken task summaries enabled"
    else
        touch "$SUMMARY_DISABLED"
        log "Global spoken task summaries kept OFF (silent mode - no turn interruption)"
    fi

    systemctl --user daemon-reload
    for svc in "${SERVICES[@]}"; do
        systemctl --user start "$svc" 2>/dev/null || true
    done

    sleep 0.5
    success "Local Voice Engine is now ON"
    echo ""
    engine_status
}

engine_off() {
    log "Turning Local Voice Engine OFF..."
    mkdir -p "$VOICEMODE_DIR"
    touch "$ENGINE_DISABLED"
    touch "$SUMMARY_DISABLED"
    touch "$SOUNDFONTS_DISABLED"

    stop_playback

    for svc in "${SERVICES[@]}"; do
        systemctl --user stop "$svc" 2>/dev/null || true
    done

    success "Local Voice Engine is now OFF (All background services stopped and silenced)"
    echo ""
    engine_status
}

engine_toggle() {
    if [ -f "$ENGINE_DISABLED" ] || ! is_service_active "claude-voice-bridge.service"; then
        engine_on "${1:-}"
    else
        engine_off
    fi
}

toggle_global_summary() {
    case "${1:-status}" in
        on|enable)
            rm -f "$SUMMARY_DISABLED"
            success "Global spoken turn summaries ENABLED"
            ;;
        off|disable)
            touch "$SUMMARY_DISABLED"
            stop_playback
            success "Global spoken turn summaries DISABLED (Silent completion mode)"
            ;;
        toggle)
            if [ -f "$SUMMARY_DISABLED" ]; then
                toggle_global_summary on
            else
                toggle_global_summary off
            fi
            ;;
        status)
            if [ -f "$SUMMARY_DISABLED" ]; then
                echo -e "Global spoken turn summaries: ${RED}DISABLED${NC}"
            else
                echo -e "Global spoken turn summaries: ${GREEN}ENABLED${NC}"
            fi
            ;;
        *)
            echo "Usage: voice-engine summary [on|off|toggle|status]"
            ;;
    esac
}

toggle_dictate() {
    case "${1:-status}" in
        on|start|enable)
            systemctl --user start dictate.service
            success "Push-to-talk dictate daemon (Right-Ctrl) STARTED"
            ;;
        off|stop|disable)
            systemctl --user stop dictate.service
            success "Push-to-talk dictate daemon STOPPED"
            ;;
        toggle)
            if is_service_active "dictate.service"; then
                toggle_dictate off
            else
                toggle_dictate on
            fi
            ;;
        status)
            if is_service_active "dictate.service"; then
                echo -e "Push-to-talk dictate daemon: ${GREEN}RUNNING${NC}"
            else
                echo -e "Push-to-talk dictate daemon: ${RED}STOPPED${NC}"
            fi
            ;;
        *)
            echo "Usage: voice-engine dictate [on|off|toggle|status]"
            ;;
    esac
}

# ==============================================================================
# Antigravity (AGY) Specific Management
# ==============================================================================

enable_agy_integration() {
    ensure_services_running
    mkdir -p "$GEMINI_CONFIG_DIR/skills/talk" "$GEMINI_CONFIG_DIR/skills/code" "$GEMINI_CONFIG_DIR/skills/voicemode"

    local src_dir="$REPO_DIR/config/agy/skills"
    if [ -d "$src_dir" ]; then
        cp -r "$src_dir/talk/SKILL.md" "$GEMINI_CONFIG_DIR/skills/talk/SKILL.md" 2>/dev/null || true
        cp -r "$src_dir/code/SKILL.md" "$GEMINI_CONFIG_DIR/skills/code/SKILL.md" 2>/dev/null || true
        cp -r "$src_dir/voicemode/SKILL.md" "$GEMINI_CONFIG_DIR/skills/voicemode/SKILL.md" 2>/dev/null || true
    fi

    # Enable MCP in mcp_config.json
    if [ -f "$GEMINI_CONFIG_DIR/mcp_config.json" ]; then
        python3 -c "
import json
p = '$GEMINI_CONFIG_DIR/mcp_config.json'
with open(p, 'r') as f:
    d = json.load(f)
d.setdefault('mcpServers', {})
d['mcpServers']['voicemode'] = {
    'command': '$USER_BIN/uvx',
    'args': ['--with', 'webrtcvad', '--with', 'setuptools<71', 'voice-mode'],
    'env': {
        'VOICEMODE_STT_BASE_URLS': 'http://127.0.0.1:2022/v1',
        'VOICEMODE_TTS_BASE_URLS': 'http://127.0.0.1:8880/v1',
        'VOICEMODE_PREFER_LOCAL': 'true',
        'VOICEMODE_ALWAYS_TRY_LOCAL': 'true',
        'VOICEMODE_CONTROL_CHANNEL_ENABLED': 'true',
        'VOICEMODE_MOUTH_BARGE': 'partial',
        'VOICEMODE_MOUTH_BARGE_WORDS': '2',
        'VOICEMODE_MOUTH_BARGE_DEVICES': '.*'
    },
    'disabled': False
}
with open(p, 'w') as f:
    json.dump(d, f, indent=2)
"
    fi
}

disable_agy_integration() {
    if [ -f "$GEMINI_CONFIG_DIR/mcp_config.json" ]; then
        python3 -c "
import json
p = '$GEMINI_CONFIG_DIR/mcp_config.json'
try:
    with open(p, 'r') as f:
        d = json.load(f)
    if 'mcpServers' in d and 'voicemode' in d['mcpServers']:
        d['mcpServers']['voicemode']['disabled'] = True
        with open(p, 'w') as f:
            json.dump(d, f, indent=2)
except Exception:
    pass
"
    fi
}

enable_agy_summary() {
    rm -f "$SUMMARY_AGY_DISABLED" "$SUMMARY_DISABLED"
    mkdir -p "$GEMINI_CONFIG_DIR"
    python3 -c "
import json
p = '$GEMINI_CONFIG_DIR/hooks.json'
try:
    with open(p, 'r') as f:
        d = json.load(f)
except Exception:
    d = {}
d['voicemode-summary-speaker'] = {
    'Stop': [
        {
            'type': 'command',
            'command': '$VOICEMODE_BIN/voicemode-hook-receiver --event Stop --client agy || true'
        }
    ]
}
with open(p, 'w') as f:
    json.dump(d, f, indent=2)
"
    speak_test_audio "Antigravity spoken summaries are now enabled."
}

disable_agy_summary() {
    touch "$SUMMARY_AGY_DISABLED"
    if [ -f "$GEMINI_CONFIG_DIR/hooks.json" ]; then
        python3 -c "
import json
p = '$GEMINI_CONFIG_DIR/hooks.json'
try:
    with open(p, 'r') as f:
        d = json.load(f)
    if 'voicemode-summary-speaker' in d:
        del d['voicemode-summary-speaker']
        with open(p, 'w') as f:
            json.dump(d, f, indent=2)
except Exception:
    pass
"
    fi
}

uninstall_agy_all() {
    log "Uninstalling all custom voice files from Antigravity..."
    disable_agy_summary
    if [ -f "$GEMINI_CONFIG_DIR/mcp_config.json" ]; then
        python3 -c "
import json
p = '$GEMINI_CONFIG_DIR/mcp_config.json'
try:
    with open(p, 'r') as f:
        d = json.load(f)
    if 'mcpServers' in d and 'voicemode' in d['mcpServers']:
        del d['mcpServers']['voicemode']
        with open(p, 'w') as f:
            json.dump(d, f, indent=2)
except Exception:
    pass
"
    fi
    rm -rf "$GEMINI_CONFIG_DIR/skills/talk"
    rm -rf "$GEMINI_CONFIG_DIR/skills/code"
    rm -rf "$GEMINI_CONFIG_DIR/skills/voicemode"
    rm -rf "$HOME/.gemini/antigravity-cli/mcp/voicemode"
    success "Antigravity voice integration completely uninstalled."
}

agy_status() {
    echo -e "${BOLD}${MAGENTA}--- Antigravity (AGY) Voice Engine Status ---${NC}"
    if is_agy_mcp_enabled; then
        echo -e "  Voice Engine Integration : ${GREEN}${BOLD}ON (ENABLED)${NC}"
    elif is_agy_mcp_installed; then
        echo -e "  Voice Engine Integration : ${YELLOW}${BOLD}OFF (DISABLED in mcp_config.json)${NC}"
    else
        echo -e "  Voice Engine Integration : ${RED}${BOLD}UNINSTALLED${NC}"
    fi

    if is_agy_summary_enabled; then
        echo -e "  Spoken Turn Summaries    : ${GREEN}${BOLD}ON (Kokoro reads completion summaries)${NC}"
    else
        echo -e "  Spoken Turn Summaries    : ${YELLOW}${BOLD}OFF (Silent completion mode)${NC}"
    fi
    echo -e "  Interactive Commands     : ${CYAN}/talk${NC}, ${CYAN}/code${NC}, ${CYAN}/voicemode${NC}"
    echo -e "${BOLD}${MAGENTA}---------------------------------------------${NC}"
}

manage_agy() {
    local subcmd="${1:-status}"
    shift || true

    case "$subcmd" in
        on|enable|start)
            log "Enabling Voice Engine for Antigravity (AGY)..."
            enable_agy_integration
            success "Antigravity voice integration is now ON."
            agy_status
            ;;
        off|disable|stop)
            log "Disabling Voice Engine for Antigravity (AGY)..."
            disable_agy_integration
            disable_agy_summary
            success "Antigravity voice integration is now OFF."
            agy_status
            ;;
        toggle)
            if is_agy_mcp_enabled; then
                manage_agy off
            else
                manage_agy on
            fi
            ;;
        summary)
            local action="${1:-status}"
            case "$action" in
                on|enable)
                    enable_agy_summary
                    success "Antigravity spoken turn summaries ENABLED."
                    ;;
                off|disable)
                    disable_agy_summary
                    success "Antigravity spoken turn summaries DISABLED."
                    ;;
                toggle)
                    if is_agy_summary_enabled; then
                        manage_agy summary off
                    else
                        manage_agy summary on
                    fi
                    ;;
                status)
                    if is_agy_summary_enabled; then
                        echo -e "Antigravity Spoken Summaries: ${GREEN}ON${NC}"
                    else
                        echo -e "Antigravity Spoken Summaries: ${YELLOW}OFF (Silent)${NC}"
                    fi
                    ;;
                *)
                    echo "Usage: voice-engine agy summary [on|off|toggle|status]"
                    ;;
            esac
            ;;
        uninstall|remove)
            uninstall_agy_all
            ;;
        test)
            speak_test_audio "${1:-Testing Antigravity voice engine audio playback.}"
            ;;
        status)
            agy_status
            ;;
        *)
            echo "Usage: voice-engine agy [on|off|toggle|status|summary|uninstall]"
            ;;
    esac
}

# ==============================================================================
# Claude Code Specific Management
# ==============================================================================

enable_claude_integration() {
    ensure_services_running
    mkdir -p "$CLAUDE_CONFIG_DIR/commands" "$CLAUDE_CONFIG_DIR/skills"

    local src_cmd="$REPO_DIR/config/claude/commands"
    if [ -d "$src_cmd" ]; then
        cp -r "$src_cmd/talk.md" "$CLAUDE_CONFIG_DIR/commands/talk.md" 2>/dev/null || true
        cp -r "$src_cmd/code.md" "$CLAUDE_CONFIG_DIR/commands/code.md" 2>/dev/null || true
        cp -r "$src_cmd/localvoice.md" "$CLAUDE_CONFIG_DIR/commands/localvoice.md" 2>/dev/null || true
    else
        cat << 'EOF' > "$CLAUDE_CONFIG_DIR/commands/localvoice.md"
Switch to local voice conversation mode using the local Whisper (Intel Arc GPU) and Kokoro TTS engine. Start speaking to me and listen for my voice replies.
EOF
        cat << 'EOF' > "$CLAUDE_CONFIG_DIR/commands/talk.md"
Switch to interactive voice conversation mode using VoiceMode (Whisper STT on Intel Arc GPU and Kokoro TTS). Start speaking to me and listen for my voice replies.
EOF
    fi

    local src_skills="$REPO_DIR/config/claude/skills"
    if [ -d "$src_skills" ]; then
        mkdir -p "$CLAUDE_CONFIG_DIR/skills/talk" "$CLAUDE_CONFIG_DIR/skills/code" "$CLAUDE_CONFIG_DIR/skills/voicemode"
        cp -r "$src_skills/talk/SKILL.md" "$CLAUDE_CONFIG_DIR/skills/talk/SKILL.md" 2>/dev/null || true
        cp -r "$src_skills/code/SKILL.md" "$CLAUDE_CONFIG_DIR/skills/code/SKILL.md" 2>/dev/null || true
        cp -r "$src_skills/voicemode/SKILL.md" "$CLAUDE_CONFIG_DIR/skills/voicemode/SKILL.md" 2>/dev/null || true
    fi

    # Keep native /voice isolated by default (no Stop hook unless summary is explicitly requested)
    if [ ! -f "$SUMMARY_CLAUDE_DISABLED" ]; then
        touch "$SUMMARY_CLAUDE_DISABLED"
    fi
}

disable_claude_integration() {
    rm -f "$CLAUDE_CONFIG_DIR/commands/talk.md"
    rm -f "$CLAUDE_CONFIG_DIR/commands/code.md"
    rm -f "$CLAUDE_CONFIG_DIR/commands/localvoice.md"
    rm -rf "$CLAUDE_CONFIG_DIR/skills/talk"
    rm -rf "$CLAUDE_CONFIG_DIR/skills/code"
    rm -rf "$CLAUDE_CONFIG_DIR/skills/voicemode"
    disable_claude_summary
}

enable_claude_summary() {
    rm -f "$SUMMARY_CLAUDE_DISABLED" "$SUMMARY_DISABLED"
    if [ -f "$CLAUDE_CONFIG_DIR/settings.json" ]; then
        python3 -c "
import json
p = '$CLAUDE_CONFIG_DIR/settings.json'
with open(p, 'r') as f:
    s = json.load(f)
s.setdefault('hooks', {})
s['hooks']['Stop'] = [
    {
        'hooks': [
            {
                'type': 'command',
                'command': '$VOICEMODE_BIN/voicemode-hook-receiver || true'
            }
        ]
    }
]
with open(p, 'w') as f:
    json.dump(s, f, indent=2)
"
    fi
    speak_test_audio "Claude Code spoken summaries are now enabled."
}

disable_claude_summary() {
    touch "$SUMMARY_CLAUDE_DISABLED"
    if [ -f "$CLAUDE_CONFIG_DIR/settings.json" ]; then
        python3 -c "
import json
p = '$CLAUDE_CONFIG_DIR/settings.json'
try:
    with open(p, 'r') as f:
        s = json.load(f)
    if 'Stop' in s.get('hooks', {}):
        del s['hooks']['Stop']
        with open(p, 'w') as f:
            json.dump(s, f, indent=2)
except Exception:
    pass
"
    fi
}

claude_status() {
    echo -e "${BOLD}${BLUE}--- Claude Code Voice Engine Status ---${NC}"
    if is_claude_commands_installed; then
        echo -e "  Custom Voice Commands    : ${GREEN}${BOLD}ON (/talk, /localvoice ready)${NC}"
    else
        echo -e "  Custom Voice Commands    : ${YELLOW}${BOLD}OFF (Commands uninstalled)${NC}"
    fi

    echo -e "  Native /voice Command    : ${GREEN}${BOLD}CLEAN (0% interference)${NC}"

    if is_claude_summary_enabled; then
        echo -e "  Spoken Turn Summaries    : ${GREEN}${BOLD}ON (Kokoro reads completion summaries)${NC}"
    else
        echo -e "  Spoken Turn Summaries    : ${YELLOW}${BOLD}OFF (Silent completion mode)${NC}"
    fi
    echo -e "${BOLD}${BLUE}---------------------------------------${NC}"
}

manage_claude() {
    local subcmd="${1:-status}"
    shift || true

    case "$subcmd" in
        on|enable|start)
            log "Enabling Voice Engine for Claude Code..."
            enable_claude_integration
            success "Claude Code voice integration is now ON."
            claude_status
            ;;
        off|disable|stop)
            log "Disabling Voice Engine for Claude Code..."
            disable_claude_integration
            success "Claude Code voice integration is now OFF."
            claude_status
            ;;
        toggle)
            if is_claude_commands_installed; then
                manage_claude off
            else
                manage_claude on
            fi
            ;;
        summary)
            local action="${1:-status}"
            case "$action" in
                on|enable)
                    enable_claude_summary
                    success "Claude Code spoken turn summaries ENABLED."
                    warn "Note: If Claude Code is already running in a terminal, restart it ('claude') so it reloads settings.json."
                    ;;
                off|disable)
                    disable_claude_summary
                    success "Claude Code spoken turn summaries DISABLED (0% interference with /voice)."
                    ;;
                toggle)
                    if is_claude_summary_enabled; then
                        manage_claude summary off
                    else
                        manage_claude summary on
                    fi
                    ;;
                status)
                    if is_claude_summary_enabled; then
                        echo -e "Claude Code Spoken Summaries: ${GREEN}ON${NC}"
                    else
                        echo -e "Claude Code Spoken Summaries: ${YELLOW}OFF (Silent / clean)${NC}"
                    fi
                    ;;
                *)
                    echo "Usage: voice-engine claude summary [on|off|toggle|status]"
                    ;;
            esac
            ;;
        hooks-off)
            disable_claude_summary
            success "Claude Code Stop hook disabled. Native /voice will run with 0% interference."
            ;;
        test)
            speak_test_audio "${1:-Testing Claude Code voice engine audio playback.}"
            ;;
        status)
            claude_status
            ;;
        *)
            echo "Usage: voice-engine claude [on|off|toggle|status|summary|hooks-off]"
            ;;
    esac
}

# ==============================================================================
# Help & Dispatcher
# ==============================================================================

show_help() {
    cat << EOF
${BOLD}voice-engine${NC} - Granular Control Switch for Claude & Antigravity Local Voice Engine

${BOLD}GLOBAL POWER SWITCHES:${NC}
    ${GREEN}voice-engine on${NC}                  Start Whisper (GPU), Bridge & Dictate daemons
    ${RED}voice-engine off${NC}                 Stop all services & silence all active audio
    ${CYAN}voice-engine toggle${NC}              Toggle entire engine between ON and OFF
    ${CYAN}voice-engine status${NC}              Display complete unified diagnostics dashboard
    ${BOLD}voice-engine summary on|off${NC}      Global toggle for spoken turn summaries

${BOLD}ANTIGRAVITY (AGY) SPECIFIC SWITCHES:${NC}
    ${GREEN}voice-engine agy on${NC}              Turn Voice Engine ON for Antigravity (MCP + skills)
    ${RED}voice-engine agy off${NC}             Turn Voice Engine OFF for Antigravity (mutes & disables)
    ${CYAN}voice-engine agy toggle${NC}          Toggle Antigravity voice integration ON/OFF
    ${CYAN}voice-engine agy status${NC}          Check Antigravity voice status
    ${BOLD}voice-engine agy summary on${NC}      Enable spoken summaries specifically for Antigravity
    ${BOLD}voice-engine agy summary off${NC}     Disable spoken summaries specifically for Antigravity
    ${RED}voice-engine agy uninstall${NC}       Cleanly remove all voice engine files from Antigravity

${BOLD}CLAUDE CODE SPECIFIC SWITCHES:${NC}
    ${GREEN}voice-engine claude on${NC}           Turn Voice Engine ON for Claude (/talk, /localvoice)
    ${RED}voice-engine claude off${NC}          Turn Voice Engine OFF for Claude (removes custom commands)
    ${CYAN}voice-engine claude toggle${NC}       Toggle Claude voice integration ON/OFF
    ${CYAN}voice-engine claude status${NC}       Check Claude Code voice status & hook cleanliness
    ${BOLD}voice-engine claude summary on${NC}   Enable spoken summaries specifically for Claude
    ${BOLD}voice-engine claude summary off${NC}  Disable spoken summaries specifically for Claude (leaves /voice 100% clean)

${BOLD}HELPERS / ALIASES:${NC}
    You can also run ${BOLD}voice-engine-agy${NC} and ${BOLD}voice-engine-claude${NC} directly:
      * voice-engine-agy on | off | summary on | summary off | status
      * voice-engine-claude on | off | summary on | summary off | status

EOF
}

# Entrypoint routing
CMD="${1:-status}"
shift || true

case "$CMD" in
    on|start|enable)
        engine_on "$@"
        ;;
    off|stop|disable)
        engine_off "$@"
        ;;
    toggle)
        engine_toggle "$@"
        ;;
    status)
        engine_status
        ;;
    summary)
        toggle_global_summary "$@"
        ;;
    dictate)
        toggle_dictate "$@"
        ;;
    agy|antigravity)
        manage_agy "$@"
        ;;
    claude)
        manage_claude "$@"
        ;;
    test)
        speak_test_audio "${1:-Testing local voice engine audio playback.}"
        ;;
    -h|--help|help)
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: $CMD${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac
