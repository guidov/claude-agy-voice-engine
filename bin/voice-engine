#!/usr/bin/env bash
# ==============================================================================
# voice-engine: Master Control & Switch for Local Whisper/Kokoro Voice Engine
# ==============================================================================
# Provides instant ON/OFF switching, status diagnostics, and clean isolation
# so the local voice engine never interferes with native /voice commands.
# ==============================================================================

set -uo pipefail

USER_BIN="$HOME/.local/bin"
VOICEMODE_DIR="$HOME/.voicemode"
VOICEMODE_BIN="$VOICEMODE_DIR/bin"
ENGINE_DISABLED="$VOICEMODE_DIR/engine-disabled"
SUMMARY_DISABLED="$VOICEMODE_DIR/summary-disabled"
SOUNDFONTS_DISABLED="$VOICEMODE_DIR/soundfonts-disabled"
GEMINI_CONFIG_DIR="$HOME/.gemini/config"
CLAUDE_CONFIG_DIR="$HOME/.claude"

SERVICES=("whisper-server.service" "claude-voice-bridge.service" "dictate.service")

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

log() { echo -e "${BLUE}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*"; }

is_service_active() {
    systemctl --user is-active --quiet "$1" 2>/dev/null
}

is_port_listening() {
    ss -tln 2>/dev/null | grep -E ":$1($|[[:space:]])" >/dev/null 2>&1 || nc -z 127.0.0.1 "$1" 2>/dev/null
}

stop_playback() {
    # Instant cutoff for active audio playback
    if [ -f "$USER_BIN/voicemode-stop" ]; then
        "$USER_BIN/voicemode-stop" >/dev/null 2>&1 || true
    fi
    pkill -f "pw-play.*voicemode" >/dev/null 2>&1 || true
}

engine_status() {
    echo -e "${BOLD}${CYAN}==========================================================${NC}"
    echo -e "${BOLD}${CYAN}    Local Voice Engine Status & Control Dashboard         ${NC}"
    echo -e "${BOLD}${CYAN}==========================================================${NC}"

    # Master state
    if [ -f "$ENGINE_DISABLED" ]; then
        echo -e "Master Engine Switch : ${RED}${BOLD}OFF (DISABLED)${NC}"
    else
        echo -e "Master Engine Switch : ${GREEN}${BOLD}ON (ENABLED)${NC}"
    fi

    # Spoken summaries
    if [ -f "$SUMMARY_DISABLED" ]; then
        echo -e "Spoken Turn Summaries: ${YELLOW}OFF (Silent / no unsolicited speech)${NC}"
    else
        echo -e "Spoken Turn Summaries: ${GREEN}ON (Kokoro reads final summaries)${NC}"
    fi

    echo ""
    echo -e "${BOLD}Background Services:${NC}"

    # whisper-server
    if is_service_active "whisper-server.service"; then
        if is_port_listening "8910"; then
            echo -e "  - whisper-server   : ${GREEN}Running (:8910 - Intel Arc Vulkan)${NC}"
        else
            echo -e "  - whisper-server   : ${YELLOW}Service active, port 8910 not yet listening${NC}"
        fi
    else
        echo -e "  - whisper-server   : ${RED}Stopped${NC}"
    fi

    # claude-voice-bridge
    if is_service_active "claude-voice-bridge.service"; then
        local stt_ok="no"
        local tts_ok="no"
        is_port_listening "2022" && stt_ok="yes"
        is_port_listening "8880" && tts_ok="yes"
        if [ "$stt_ok" = "yes" ] && [ "$tts_ok" = "yes" ]; then
            echo -e "  - voice-bridge     : ${GREEN}Running (STT :2022, TTS :8880)${NC}"
        else
            echo -e "  - voice-bridge     : ${YELLOW}Running (STT: $stt_ok, TTS: $tts_ok)${NC}"
        fi
    else
        echo -e "  - voice-bridge     : ${RED}Stopped${NC}"
    fi

    # dictate.service
    if is_service_active "dictate.service"; then
        echo -e "  - push-to-talk     : ${GREEN}Running (Right-Ctrl dictate daemon)${NC}"
    else
        echo -e "  - push-to-talk     : ${RED}Stopped${NC}"
    fi

    echo ""
    echo -e "${BOLD}Integration States:${NC}"

    # Antigravity (AGY)
    local agy_mcp="no"
    local agy_hook="no"
    if [ -f "$GEMINI_CONFIG_DIR/mcp_config.json" ]; then
        if grep -q '"voicemode"' "$GEMINI_CONFIG_DIR/mcp_config.json" 2>/dev/null; then
            agy_mcp="configured"
        fi
    fi
    if [ -f "$GEMINI_CONFIG_DIR/hooks.json" ]; then
        if grep -q "voicemode" "$GEMINI_CONFIG_DIR/hooks.json" 2>/dev/null; then
            agy_hook="active"
        fi
    fi

    if [ "$agy_mcp" = "configured" ]; then
        echo -e "  - Antigravity (AGY): ${GREEN}Installed${NC} (MCP: ready, auto-summary hook: $agy_hook)"
    else
        echo -e "  - Antigravity (AGY): ${YELLOW}Not configured / uninstalled${NC}"
    fi

    # Claude Code
    local claude_cmd="no"
    local claude_hook="clean"
    if [ -f "$CLAUDE_CONFIG_DIR/commands/talk.md" ] || [ -f "$CLAUDE_CONFIG_DIR/commands/localvoice.md" ]; then
        claude_cmd="yes (/talk, /localvoice)"
    fi
    if [ -f "$CLAUDE_CONFIG_DIR/settings.json" ]; then
        if python3 -c "import json; s=json.load(open('$CLAUDE_CONFIG_DIR/settings.json')); exit(0 if 'Stop' in s.get('hooks',{}) else 1)" 2>/dev/null; then
            claude_hook="has Stop hook (may speak summary on turn finish)"
        else
            claude_hook="clean (never interferes with /voice)"
        fi
    fi
    echo -e "  - Claude Code      : ${GREEN}Ready${NC} (Commands: $claude_cmd, Hooks: $claude_hook)"
    echo -e "${BOLD}${CYAN}==========================================================${NC}"
}

engine_on() {
    log "Turning Local Voice Engine ON..."
    mkdir -p "$VOICEMODE_DIR"
    rm -f "$ENGINE_DISABLED"

    # Handle summary flag
    if [[ "${1:-}" == "--summary" ]] || [[ "${1:-}" == "--with-summary" ]]; then
        rm -f "$SUMMARY_DISABLED"
        log "Spoken task summaries enabled"
    else
        touch "$SUMMARY_DISABLED"
        log "Spoken task summaries kept OFF (silent mode - no turn interruption)"
    fi

    systemctl --user daemon-reload
    for svc in "${SERVICES[@]}"; do
        systemctl --user start "$svc" 2>/dev/null || true
    done

    # Give bridge a brief moment to bind
    sleep 0.5
    success "Local Voice Engine is now ON"
    echo ""
    engine_status
}

engine_off() {
    log "Turning Local Voice Engine OFF..."
    mkdir -p "$VOICEMODE_DIR"
    touch "$ENGINE_DISABLED"
    touch "$SUMMARY_DISABLED"
    touch "$SOUNDFONTS_DISABLED"

    stop_playback

    for svc in "${SERVICES[@]}"; do
        systemctl --user stop "$svc" 2>/dev/null || true
    done

    success "Local Voice Engine is now OFF (All background services stopped and silenced)"
    echo ""
    engine_status
}

engine_toggle() {
    if [ -f "$ENGINE_DISABLED" ] || ! is_service_active "claude-voice-bridge.service"; then
        engine_on "${1:-}"
    else
        engine_off
    fi
}

toggle_summary() {
    case "${1:-status}" in
        on|enable)
            rm -f "$SUMMARY_DISABLED"
            success "Spoken turn summaries ENABLED (Kokoro will read completion summaries)"
            ;;
        off|disable)
            touch "$SUMMARY_DISABLED"
            stop_playback
            success "Spoken turn summaries DISABLED (Silent completion mode)"
            ;;
        toggle)
            if [ -f "$SUMMARY_DISABLED" ]; then
                toggle_summary on
            else
                toggle_summary off
            fi
            ;;
        status)
            if [ -f "$SUMMARY_DISABLED" ]; then
                echo -e "Spoken turn summaries: ${RED}DISABLED${NC}"
            else
                echo -e "Spoken turn summaries: ${GREEN}ENABLED${NC}"
            fi
            ;;
        *)
            echo "Usage: voice-engine summary [on|off|toggle|status]"
            ;;
    esac
}

toggle_dictate() {
    case "${1:-status}" in
        on|start|enable)
            systemctl --user start dictate.service
            success "Push-to-talk dictate daemon (Right-Ctrl) STARTED"
            ;;
        off|stop|disable)
            systemctl --user stop dictate.service
            success "Push-to-talk dictate daemon STOPPED"
            ;;
        toggle)
            if is_service_active "dictate.service"; then
                toggle_dictate off
            else
                toggle_dictate on
            fi
            ;;
        status)
            if is_service_active "dictate.service"; then
                echo -e "Push-to-talk dictate daemon: ${GREEN}RUNNING${NC}"
            else
                echo -e "Push-to-talk dictate daemon: ${RED}STOPPED${NC}"
            fi
            ;;
        *)
            echo "Usage: voice-engine dictate [on|off|toggle|status]"
            ;;
    esac
}

manage_agy() {
    case "${1:-status}" in
        uninstall|remove)
            log "Uninstalling custom voice engine from Antigravity (AGY)..."
            # 1. Remove from mcp_config.json
            if [ -f "$GEMINI_CONFIG_DIR/mcp_config.json" ]; then
                python3 -c "
import json
p = '$GEMINI_CONFIG_DIR/mcp_config.json'
try:
    with open(p, 'r') as f:
        data = json.load(f)
    if 'mcpServers' in data and 'voicemode' in data['mcpServers']:
        del data['mcpServers']['voicemode']
        with open(p, 'w') as f:
            json.dump(data, f, indent=2)
        print('Removed voicemode from mcp_config.json')
except Exception as e:
    print('Error updating mcp_config.json:', e)
"
            fi

            # 2. Remove Stop hook from hooks.json
            if [ -f "$GEMINI_CONFIG_DIR/hooks.json" ]; then
                python3 -c "
import json
p = '$GEMINI_CONFIG_DIR/hooks.json'
try:
    with open(p, 'r') as f:
        data = json.load(f)
    if 'voicemode-summary-speaker' in data:
        del data['voicemode-summary-speaker']
    with open(p, 'w') as f:
        json.dump(data, f, indent=2)
    print('Removed voicemode hook from hooks.json')
except Exception as e:
    print('Error updating hooks.json:', e)
"
            fi

            # 3. Remove skills
            rm -rf "$GEMINI_CONFIG_DIR/skills/talk"
            rm -rf "$GEMINI_CONFIG_DIR/skills/code"
            rm -rf "$GEMINI_CONFIG_DIR/skills/voicemode"

            # 4. Clean cache
            rm -rf "$HOME/.gemini/antigravity-cli/mcp/voicemode"

            success "Antigravity voice integration uninstalled cleanly."
            ;;
        enable|install)
            log "Configuring Antigravity (AGY) integration (non-interfering mode)..."
            local repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
            mkdir -p "$GEMINI_CONFIG_DIR/skills/talk" "$GEMINI_CONFIG_DIR/skills/code" "$GEMINI_CONFIG_DIR/skills/voicemode"
            cp "$repo_dir/config/agy/skills/talk/SKILL.md" "$GEMINI_CONFIG_DIR/skills/talk/SKILL.md" 2>/dev/null || true
            cp "$repo_dir/config/agy/skills/code/SKILL.md" "$GEMINI_CONFIG_DIR/skills/code/SKILL.md" 2>/dev/null || true
            cp "$repo_dir/config/agy/skills/voicemode/SKILL.md" "$GEMINI_CONFIG_DIR/skills/voicemode/SKILL.md" 2>/dev/null || true

            # Register MCP server
            if [ -f "$GEMINI_CONFIG_DIR/mcp_config.json" ]; then
                python3 -c "
import json
p = '$GEMINI_CONFIG_DIR/mcp_config.json'
with open(p, 'r') as f:
    d = json.load(f)
d.setdefault('mcpServers', {})
d['mcpServers']['voicemode'] = {
    'command': '$USER_BIN/uvx',
    'args': ['--with', 'webrtcvad', '--with', 'setuptools<71', 'voice-mode'],
    'env': {
        'VOICEMODE_STT_BASE_URLS': 'http://127.0.0.1:2022/v1',
        'VOICEMODE_TTS_BASE_URLS': 'http://127.0.0.1:8880/v1',
        'VOICEMODE_PREFER_LOCAL': 'true',
        'VOICEMODE_ALWAYS_TRY_LOCAL': 'true',
        'VOICEMODE_CONTROL_CHANNEL_ENABLED': 'true',
        'VOICEMODE_MOUTH_BARGE': 'partial',
        'VOICEMODE_MOUTH_BARGE_WORDS': '2',
        'VOICEMODE_MOUTH_BARGE_DEVICES': '.*'
    }
}
with open(p, 'w') as f:
    json.dump(d, f, indent=2)
"
            fi
            # Note: We intentionally DO NOT add automatic Stop hook to avoid unsolicited speech!
            success "Antigravity integration enabled cleanly (MCP server + skills, zero automatic interruption)."
            ;;
        disable)
            if [ -f "$GEMINI_CONFIG_DIR/mcp_config.json" ]; then
                python3 -c "
import json
p = '$GEMINI_CONFIG_DIR/mcp_config.json'
with open(p, 'r') as f:
    d = json.load(f)
if 'mcpServers' in d and 'voicemode' in d['mcpServers']:
    d['mcpServers']['voicemode']['disabled'] = True
    with open(p, 'w') as f:
        json.dump(d, f, indent=2)
"
                success "Antigravity voicemode MCP disabled."
            fi
            ;;
        status)
            engine_status
            ;;
        *)
            echo "Usage: voice-engine agy [enable|disable|uninstall|status]"
            ;;
    esac
}

manage_claude() {
    case "${1:-status}" in
        hooks-off|disable-hooks)
            log "Disabling intrusive hooks in Claude Code (ensures /voice is never interfered with)..."
            if [ -f "$CLAUDE_CONFIG_DIR/settings.json" ]; then
                python3 -c "
import json
p = '$CLAUDE_CONFIG_DIR/settings.json'
with open(p, 'r') as f:
    s = json.load(f)
if 'Stop' in s.get('hooks', {}):
    del s['hooks']['Stop']
with open(p, 'w') as f:
    json.dump(s, f, indent=2)
print('Stop hook cleanly removed from Claude settings.json')
"
            fi
            success "Claude Code Stop hook disabled. Claude's native /voice will run with 0% interference."
            ;;
        status)
            engine_status
            ;;
        *)
            echo "Usage: voice-engine claude [hooks-off|status]"
            ;;
    esac
}

show_help() {
    cat << EOF
${BOLD}voice-engine${NC} - Master Control Switch for Claude & Antigravity Local Voice Engine

${BOLD}USAGE:${NC}
    voice-engine <COMMAND> [OPTIONS]

${BOLD}CORE SWITCH COMMANDS:${NC}
    ${GREEN}on${NC} | ${GREEN}start${NC} [--summary]     Turn the voice engine ON (starts whisper, bridge, dictate)
    ${RED}off${NC} | ${RED}stop${NC}                 Turn the voice engine OFF (stops all services & silences audio)
    ${CYAN}toggle${NC}                     Toggle the voice engine between ON and OFF
    ${CYAN}status${NC}                     Display comprehensive status dashboard

${BOLD}INDEPENDENT COMPONENT SWITCHES:${NC}
    ${BOLD}summary${NC} [on|off|toggle|status]  Toggle spoken task summaries (Kokoro TTS after tasks)
    ${BOLD}dictate${NC} [on|off|toggle|status]  Toggle Right-Ctrl push-to-talk daemon

${BOLD}CLIENT INTEGRATION SWITCHES:${NC}
    ${BOLD}agy${NC} enable                      Enable Antigravity skills & MCP (quiet, non-interfering)
    ${BOLD}agy${NC} disable                     Disable Antigravity voicemode MCP server
    ${BOLD}agy${NC} uninstall                   Cleanly remove all voice engine files from Antigravity
    ${BOLD}claude${NC} hooks-off                Ensure Claude Code hooks never interfere with native /voice

${BOLD}HOW IT RUNS SEPARATELY FROM /voice:${NC}
    - In Claude Code:
        * ${BOLD}/voice${NC}       ➔ Native Claude Cloud Voice (completely untouched & unhooked)
        * ${BOLD}/localvoice${NC}  ➔ Custom local Whisper STT (Arc GPU) + Kokoro TTS
        * ${BOLD}/talk${NC}        ➔ Custom local voice conversation mode
    - In Antigravity (AGY):
        * ${BOLD}/talk${NC}        ➔ Interactive voice session via local engine
        * Hold ${BOLD}Right-Ctrl${NC} ➔ Push-to-talk dictation with instant barge-in

EOF
}

# Entrypoint routing
CMD="${1:-status}"
shift || true

case "$CMD" in
    on|start|enable)
        engine_on "$@"
        ;;
    off|stop|disable)
        engine_off "$@"
        ;;
    toggle)
        engine_toggle "$@"
        ;;
    status)
        engine_status
        ;;
    summary)
        toggle_summary "$@"
        ;;
    dictate)
        toggle_dictate "$@"
        ;;
    agy)
        manage_agy "$@"
        ;;
    claude)
        manage_claude "$@"
        ;;
    -h|--help|help)
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: $CMD${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac
